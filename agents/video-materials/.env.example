# video-materials agent — copy to .env and fill in. NEVER commit .env.

# ── Claude Code subscription (NOT the paid API) ─────────────────────────────
# No token needed. The runner calls `claude -p` and reuses your logged-in Claude
# Code session (Pro/Max) — just run `claude` once interactively to sign in. It
# strips ANTHROPIC_API_KEY from the child env so a stray key can never cause
# paid, per-token billing.
# Optional: pin a model. Empty = subscription default (e.g. claude-sonnet-4-6).
CLAUDE_MODEL=

# ── Supabase (same project as the dashboard; service-role = server-side) ────
# These are the dashboard's NEXT_PUBLIC_SUPABASE_URL and SUPABASE_SERVICE_ROLE_KEY,
# just without the NEXT_PUBLIC_ prefix. The service-role key bypasses RLS — keep
# it secret, this file is gitignored.
SUPABASE_URL=https://wdzmuniyqqyngzckeoph.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_THUMBNAIL_BUCKET=news-thumbnails

# ── ai-news-mcp (deterministic, free, no auth) ──────────────────────────────
AI_NEWS_MCP_URL=https://iiwkkrvyhktnwolsfndx.supabase.co/functions/v1/mcp
