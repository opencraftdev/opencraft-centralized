NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Parent repo env vars (still needed for generate routes)
REPO_ROOT=..
ANTHROPIC_API_KEY=
YOUTUBE_API_KEY=
ZERNIO_API_KEY=

# AWS S3 — used both for legacy video uploads and for presigning Document Agent
# document links in the monitoring dashboard (read-only GET presign).
# Leave unset to fall back to each document's stored file_url / Supabase Storage.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET=
AWS_S3_REGION=

# ── Monitoring / telemetry (opencraft-centralized) ──────────────────────────
# The dashboard READS telemetry with the anon/service keys above. Agents WRITE
# telemetry to /api/ingest/* using a per-agent API key (Authorization: Bearer).
# Set each agent's key hash in the DB (see supabase/migrations/002_*.sql), e.g.:
#   update agents set api_key_hash = encode(digest('THE_RAW_KEY','sha256'),'hex')
#   where slug = 'document-agent';
# The Document Agent repo then configures:
#   OPENCRAFT_MONITOR_URL=https://<this-dashboard-host>
#   OPENCRAFT_MONITOR_API_KEY=THE_RAW_KEY

# ── Blog Monitoring Bot (Blogpost Automation agent) ─────────────────────────
# The blog pipeline publishes straight into the shared `articles` table, so the
# bot PULLS instead of receiving pushes: it reconciles `articles` into the
# telemetry tables (src/lib/monitor/blog-bot.ts) using the service-role key.
# Trigger it on a schedule via POST/GET /api/monitor/blog/sync, protected by:
MONITOR_CRON_SECRET=
# Public site the bot links each tracked article to (/{locale}/blog/{slug}).
BLOG_PUBLIC_BASE_URL=https://ocraft.id
BLOG_PUBLIC_LOCALE=id

# ── Blogs → Performance (real Google data) ──────────────────────────────────
# Search metrics (visits, impressions, click-rate, rank, top queries/pages) come
# from the Google Search Console API; page-experience (LCP/INP/CLS) from the
# PageSpeed Insights / CrUX API. Without these set, the Performance page shows a
# "Search Console not connected" state (and CWV still works if the key is set).
#
# 1) Create a Google Cloud service account, enable the "Search Console API", and
#    download its JSON key. In Search Console → Settings → Users and permissions,
#    add the service account's client_email as a Full/Restricted user on the
#    ocraft.id property.
# Point to the key file (dev) OR paste the JSON (raw or base64) for hosted envs:
GOOGLE_SERVICE_ACCOUNT_FILE=
GOOGLE_SERVICE_ACCOUNT_JSON=
# The Search Console property. Domain property → "sc-domain:ocraft.id";
# URL-prefix property → "https://ocraft.id/". Defaults to sc-domain:ocraft.id.
GSC_SITE_URL=sc-domain:ocraft.id
#
# 2) For Core Web Vitals, enable the "PageSpeed Insights API" and create an API
#    key (no property verification needed). Optional but recommended (raises the
#    rate limit). The page measured defaults to {BASE_URL}/{LOCALE}/blog.
PAGESPEED_API_KEY=
SEO_CWV_URL=

# ── Cloudinary (Record Tutorial Video feature) ─────────────────────────────
# Renders vertical 1080×1920 tutorials: logo + name overlay on the opening,
# burned-in captions, fixed outro appended. Free plan = 25 credits / 30-day
# cycle, no watermark. CLOUDINARY_API_SECRET is server-only — never expose it.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# Public IDs of the fixed assets uploaded to the Cloudinary Media Library.
CLOUDINARY_OUTRO_PUBLIC_ID=
CLOUDINARY_LOGO_PUBLIC_ID=
# Burned-in captions need the google_video_transcription add-on (one-click
# enable in the Cloudinary console; costs credits). Set to 1 to turn captions
# on; leave unset/empty to render without captions (safe default).
CLOUDINARY_CAPTIONS=
# Optional public URL Cloudinary can POST render-complete webhooks to. Without
# it the status route polls Cloudinary (fine for local dev).
TUTORIAL_VIDEO_WEBHOOK_URL=

# ── Brief-first recording (desktop recorder deep link) ──────────────────────
# Secret used to HMAC-sign the short-lived token embedded in the recorder deep
# link. The mint-link route signs it; the brief-fetch route verifies it instead
# of a Supabase session (the desktop recorder has no session). Server-only —
# never expose. If unset, link minting throws and token verification fails
# closed. Generate with: openssl rand -hex 32
RECORDER_TOKEN_SECRET=
# Custom URL scheme the desktop recorder registers; the mint-link route builds
# the deep link from this. Defaults to opencraft-recorder://record if unset.
NEXT_PUBLIC_RECORDER_DEEP_LINK=opencraft-recorder://record
# Where to send users to download the recorder if the deep link doesn't launch.
# Defaults to the latest GitHub release asset if unset.
NEXT_PUBLIC_RECORDER_DOWNLOAD_URL=https://github.com/opencraftdev/opencraft-recorder/releases/latest/download/opencraft-recorder-mac-arm64.dmg
